# ---------------------------------------------------------------------------
# Byond Borders Cruise Concierge — git ignore rules
# ---------------------------------------------------------------------------

# --- Secrets ---------------------------------------------------------------
# The real environment file with API keys. Only .env.example is committed.
.env

# --- Generated data (rebuilt locally by the ingest pipeline) ---------------
# The SQLite database and the vector store are true local build output — each
# machine regenerates them by running ingest, so they are NOT committed.
data/app.db
data/chroma/

# NOTE: the committed source snapshots below are deliberately NOT ignored, so this
# repo is self-contained at runtime — clone, install, ingest, run. `sailings-index.json`
# is now built HERE by `npm run build:index` (scripts/build-sailings-index.mjs);
# `cruise-lines.json` + the knowledge briefs are still published from the website repo
# (scripts/export-cruise-content.mjs). No secrets, no prices:
#   data/cruise-lines.json     (cruise-line content — from website)
#   data/sailings-index.json   (sailings search index — built here)
#   data/knowledge/*.md        (research briefs — the RAG source prose)

# --- Node (build-time data pipeline only; the engine runtime is Python) -----
node_modules/

# --- Scraper sessions & caches (acquisition scripts, moved here in TD.1) -----
# Portal logins save SESSION COOKIES (never passwords) and the fetchers cache raw
# page bodies. None of this may ever be committed — it's machine-local and
# credentials-adjacent. Ignored wherever it lands under the repo.
**/workdir/
**/.auth/
**/storageState.json
**/raw/
**/samples/
**/request-shape.json
**/disney-urls.json

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/

# --- Virtualenvs -----------------------------------------------------------
.venv/
venv/
