# Keep the build context lean and never copy local state into the image.
# (Committed source snapshots in data/*.json and data/knowledge/*.md ARE needed,
# so they are deliberately NOT excluded.)
.git
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
.venv/
venv/
data/app.db
data/chroma/
# Build-time / dev-only, not needed at runtime:
scripts/
evals/
**/workdir/
**/.auth/
