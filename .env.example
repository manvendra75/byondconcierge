# ---------------------------------------------------------------------------
# Byond Borders Cruise Concierge — environment template
# Copy this file to ".env" and fill in the secrets. The .env file is
# git-ignored; this .example is the committed, secret-free reference.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM provider (required) -----------------------------------------------
# Your OpenAI API key. Without it the agent cannot answer questions.
OPENAI_API_KEY=

# Which OpenAI models to use for each tier. The small/fast model handles cheap
# steps (intent classification, filter extraction); the large model handles
# answer synthesis and comparisons. Overriding these is how you tune the
# cost/quality trade-off — engine/config.py reads them, nothing else.
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_LARGE=gpt-4o

# --- Lead notifications (optional) -----------------------------------------
# Resend API key for emailing captured leads to the sales desk. Leave BLANK
# to run in dev mode: leads are still saved to the database and the email is
# printed to the console instead of being sent.
RESEND_API_KEY=

# Where lead-enquiry emails are delivered.
SALES_EMAIL=sales@byondborders.com

# --- Local storage paths ---------------------------------------------------
# SQLite database file (users, sessions, messages, leads, traces, sailings).
DB_PATH=data/app.db

# On-disk directory for the ChromaDB vector store (the RAG knowledge base).
CHROMA_DIR=data/chroma
